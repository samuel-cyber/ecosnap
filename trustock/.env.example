# ---------------------------------------------------------------------------
# Trustock configuration
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL. Create the database first:
#   createdb trustock
DATABASE_URL=postgres://trustock:trustock@127.0.0.1:5432/trustock

# Signing key for session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Ecobank
#
# ECOBANK_MODE=simulated  ->  money movement is handled by Trustock's labelled
#                             simulator. Nothing real happens, and the API and
#                             UI say so on every transaction. This is the
#                             default and the safe setting for a demo.
#
# ECOBANK_MODE=live       ->  Trustock calls the configured Ecobank API. The
#                             app refuses to start in this mode unless every
#                             credential below is present, so it can never
#                             look like a live integration when it is not.
#
# The endpoint paths are configuration because the InnovateX-issued Ecobank
# documentation is the source of truth for them; confirm each one against that
# documentation before switching to live.
# ---------------------------------------------------------------------------
ECOBANK_MODE=simulated
ECOBANK_BASE_URL=
ECOBANK_LAB_ID=
ECOBANK_USERNAME=
ECOBANK_PASSWORD=
ECOBANK_AFFILIATE_CODE=ENG
ECOBANK_SOURCE_ACCOUNT=
ECOBANK_PATH_TOKEN=/user/token
ECOBANK_PATH_PAYMENT=/merchant/payment
ECOBANK_PATH_COLLECTION=/merchant/collection
ECOBANK_PATH_STATUS=/merchant/transactionstatus
ECOBANK_TIMEOUT_MS=15000

# Simulator only: artificial latency so the UI's pending states are visible.
SIMULATOR_LATENCY_MS=250
